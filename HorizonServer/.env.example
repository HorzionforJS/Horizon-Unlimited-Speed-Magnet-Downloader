# 复制为 .env 使用；生产环境务必改成强随机值
HORIZON_JWT_SECRET=replace-with-a-long-random-string

# 数据库类型：postgres（默认，生产）| sqlite（回退，可单独跑）
DB_TYPE=postgres
POSTGRES_USER=horizon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=horizon
# PostgreSQL DSN 由 docker-compose 依据上面变量自动拼接

# S3 / MinIO 离线导出
MINIO_ROOT_USER=horizon
MINIO_ROOT_PASSWORD=change-me

# Grafana
GRAFANA_PASSWORD=change-me

# —— 电影天堂元数据（封面 / 名称 / 简介）——
# 启用后后端会对外抓取影视元数据，并在 /api/v1/dytt/* 暴露给客户端。
# 内容源对高频请求会直接返回 HTTP 400，因此必须由服务端限速抓取，
# 客户端不要直连。不需要该功能时设为 false 即可完全关闭外呼。
HORIZON_DYTT_ENABLED=true
HORIZON_DYTT_BASE_URL=https://dytt.org.cn
HORIZON_DYTT_REFERER=https://home.dytiantang.com.cn/
HORIZON_DYTT_CACHE_TTL=30m
HORIZON_DYTT_MIN_INTERVAL=400ms

# —— 种子检索（中文片名自动翻译）——
# 索引站（apibay / The Pirate Bay）几乎只含英文片名：直接拿中文片名去查会返回满屏
# 无关热门种子（实测搜「云雀叫天录」返回《蜘蛛侠》）。开启后服务端先把中文片名
# 翻译成英文再检索，并按片名词元过滤掉不相关结果（实测「流浪地球」40 条全相关）。
# 译文有 24h 缓存，且只翻译含中日韩字符的关键词，纯英文查询零额外开销。
HORIZON_TRANSLATE_ENABLED=true
HORIZON_TRANSLATE_URL=https://transmart.qq.com/api/imt
HORIZON_TRANSLATE_TTL=24h
# 种子索引站点（需兼容 apibay API）
HORIZON_TPB_BASE=https://apibay.org

# —— BT 网络（DHT）——
# DHT 走 UDP。部分网络会针对性封锁 BT 的 UDP 流量（实测 UDP tracker 与 DHT 引导
# 节点全部无回包，而 DNS 的 UDP 正常回包），此时 DHT 只会徒增等待，建议设为 false，
# 仅靠 tracker 与 PEX 找 peer。放行 BT 的服务器保持 true 即可。
HORIZON_DHT_ENABLED=true

# —— uTP（BT over UDP）——
# uTP 同样走 UDP。在封锁 BT/UDP 的网络里，握手能走 TCP、数据阶段切到 uTP 后即被丢包，
# 表现为「连上 peer 却 0 字节」。实测同一 magnet：开 uTP 3 连接/0 种子，关 uTP
# 7 连接/6 种子。默认关闭以强制 TCP，最稳；UDP 干净的网络可设 true。
HORIZON_UTP_ENABLED=false

# —— TMDb 元数据增强（可选）——
# 不配 API Key 时完全跳过，只返回电影天堂自身的元数据。
# Key 在 https://www.themoviedb.org/settings/api 免费申请。
HORIZON_TMDB_API_KEY=
HORIZON_TMDB_LANGUAGE=zh-CN
